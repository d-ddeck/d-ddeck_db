# ============================================================
#  d-ddeck DB Server - environment
#  Copy to `.env` and edit.  NEVER commit `.env`.
# ============================================================

APP_NAME="d-ddeck DB Server"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ---- Database -------------------------------------------------
# Skeleton default (no install needed):
DATABASE_URL=sqlite+pysqlite:///./ddeck.db
# Production (PostgreSQL) - just swap this one line:
# DATABASE_URL=postgresql+psycopg://ddeck:CHANGE_ME@127.0.0.1:5432/ddeck

# ---- Security -------------------------------------------------
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_dev_only_secret_key_do_not_use_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_MIN_LENGTH=8

# ---- CORS (FlutterFlow web preview / desktop dev) -------------
# Comma separated. "*" allowed only when DEBUG=true.
CORS_ORIGINS=*

# ---- Bootstrap super admin (created on first start) -----------
FIRST_SUPERADMIN_EMAIL=admin@ddeck.local
FIRST_SUPERADMIN_PASSWORD=admin1234
FIRST_SUPERADMIN_NAME=SuperAdmin

# ---- File storage ---------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# ---- Notification / scheduler ---------------------------------
SCHEDULER_ENABLED=true
REMINDER_SCAN_SECONDS=60
# Firebase Cloud Messaging (optional, push to Android). Empty = in-app only.
FCM_SERVER_KEY=
