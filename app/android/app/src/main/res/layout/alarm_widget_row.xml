<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/alarm_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/alarm_widget_row_background">
    <TextView android:id="@+id/alarm_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/alarm_widget_accent" android:textSize="12sp" />
    <TextView android:id="@+id/alarm_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/alarm_widget_text" android:textSize="15sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/alarm_place" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/alarm_widget_secondary" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
