<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/alarm_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/alarm_heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:text="일정" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/alarm_widget_text" />
        <TextView android:id="@+id/alarm_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="48dp" android:padding="8dp" android:gravity="center" android:text="새로고침" android:contentDescription="앱에서 서버 캘린더 동기화" android:textSize="12sp" android:textColor="@color/alarm_widget_accent" />
    </LinearLayout>
    <TextView android:id="@+id/alarm_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="저장된 일정 알람" android:textColor="@color/alarm_widget_secondary" android:textSize="11sp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="24dp">
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="일" android:textSize="12sp" android:textColor="@color/alarm_widget_secondary" />
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="월" android:textSize="12sp" android:textColor="@color/alarm_widget_secondary" />
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="화" android:textSize="12sp" android:textColor="@color/alarm_widget_secondary" />
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="수" android:textSize="12sp" android:textColor="@color/alarm_widget_secondary" />
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="목" android:textSize="12sp" android:textColor="@color/alarm_widget_secondary" />
