<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9(API 28)부터 평문 HTTP 는 기본 차단된다.
  사내 서버는 http://192.168.0.20:8000 처럼 HTTP 로 동작하므로 허용이 필요하다.
  이 설정이 없으면 브라우저로는 열리는 서버가 앱에서는 연결 실패로 나타난다.

  서버 주소를 사용자가 바꿀 수 있는 앱이라 도메인을 미리 특정할 수 없어
  base-config 로 허용한다. 대상이 사내망/VPN 안의 서버라 노출 범위는 제한적이다.

  나중에 서버에 HTTPS 를 붙이면 (사내 CA 를 쓸 경우) 아래 주석을 참고해
  cleartextTrafficPermitted 를 false 로 바꾸고 신뢰 인증서를 등록하면 된다.

    <base-config cleartextTrafficPermitted="false">
      <trust-anchors>
        <certificates src="system"/>
        <certificates src="@raw/company_ca"/>
      </trust-anchors>
    </base-config>
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
